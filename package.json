{
  "name": "folder-app",
  "version": "0.1.0-test.1",
  "private": true,
  "description": "Folder App test release 1",
  "main": "src/app/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "pack:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^29.1.1"
  },
  "build": {
    "appId": "local.folderapp.desktop",
    "productName": "Folder App",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
